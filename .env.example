# EdgeOne Makers 环境变量配置示例

# Cloudflare Turnstile 密钥（生产环境请替换为真实密钥，未填写则使用 Cloudflare 官方测试密钥）
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Cravatar / Gravatar 镜像地址（国内推荐 cravatar.cn）
GRAVATAR_MIRROR=https://cravatar.cn/avatar/

# 管理员后台密码（配置后作为后台登录凭据；若留空则使用初始密码 admin123）
ADMIN_SECRET_KEY=your_secure_admin_password
